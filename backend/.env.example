DATABASE_URL=postgresql+asyncpg://paas:paas@127.0.0.1:5433/paas
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:8000 
PUBLIC_API_BASE_URL=http://127.0.0.1:8000 
DEPLOYMENT_URL_TEMPLATE=http://127.0.0.1:{port}{path}{query}

DOCKER_NETWORK=paas_isolated
DOCKER_INTERNAL_PORT=8080
DOCKER_HOST_PORT_START=20000
DOCKER_HOST_PORT_END=30000
DOCKER_READ_ONLY_DEFAULT=false
DOCKER_AUTO_RESTART_UNHEALTHY=false

RESOURCE_POOL_MAX_CPU=4.0
RESOURCE_POOL_MAX_RAM_MB=4096
RESOURCE_POOL_MAX_STORAGE_MB=32768
RESOURCE_POOL_MAX_PIDS=1024
RESOURCE_POOL_MAX_DEPLOYMENTS=20
RESOURCE_POOL_MAX_INSTANCES_PER_DEPLOYMENT=8
AUTOSCALE_CPU_THRESHOLD_PERCENT=75.0

LOG_LEVEL=INFO
